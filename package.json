{
  "name": "gaming-stats-api",
  "version": "3.2.0",
  "description": "Self-hostable gaming stats API with cached Valorant, PSN, Steam, and Epic integrations",
  "keywords": [
    "valorant",
    "steam",
    "psn",
    "epic-games",
    "gaming",
    "api",
    "stats",
    "tracker-gg",
    "apify",
    "express",
    "self-hosted"
  ],
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "refresh:snapshots": "node src/refreshTrackedUsers.js",
    "refresh:profiles": "node src/refreshHenrikProfiles.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "psn:init-key": "node scripts/psn/cli.js init-key",
    "psn:connect": "node scripts/psn/cli.js connect",
    "psn:connect:production": "PSN_SECURE_TTY=1 node scripts/psn/cli.js connect",
    "psn:refresh": "node scripts/psn/cli.js refresh",
    "psn:status": "node scripts/psn/cli.js status",
    "psn:disconnect": "node scripts/psn/cli.js disconnect",
    "steam:status": "node scripts/steam/cli.js status",
    "steam:refresh": "node scripts/steam/cli.js refresh",
    "steam:refresh-game": "node scripts/steam/cli.js refresh-game",
    "epic:connect": "node scripts/epic/cli.js connect",
    "epic:connect:production": "EPIC_SECURE_TTY=1 node scripts/epic/cli.js connect",
    "epic:refresh": "node scripts/epic/cli.js refresh",
    "epic:status": "node scripts/epic/cli.js status",
    "epic:disconnect": "node scripts/epic/cli.js disconnect",
    "test:psn": "jest tests/psn --runInBand",
    "test:steam": "jest tests/steam --runInBand",
    "test:epic": "jest tests/epic --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "clearMocks": true
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.22.1"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "qs": "6.16.0"
  },
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniketRaj314/gaming-stats-api.git"
  },
  "homepage": "https://github.com/AniketRaj314/gaming-stats-api#readme",
  "bugs": {
    "url": "https://github.com/AniketRaj314/gaming-stats-api/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.2.0",
    "supertest": "^7.2.2"
  }
}
