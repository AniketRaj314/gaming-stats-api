APIFY_TOKEN=your_token_here
APIFY_MEMORY_MB=2048
HENRIK_API_KEY=your_henrikdev_key_here
PORT=3000
# Comma-separated API keys — required even for local development.
API_KEYS=key-alice,key-bob
# Comma-separated Riot IDs to track. Quote values because # starts a comment in .env files.
TRACKED_USERNAMES="Spider31415#6921"
# Enable built-in automatic snapshot refresh inside the API process.
ENABLE_AUTO_REFRESH=true
# Refresh cadence for the built-in scheduler and nextRefreshAt calculation.
REFRESH_INTERVAL_HOURS=48

# PSN is opt-in and uses its own encrypted session and SQLite snapshots.
ENABLE_PSN=false
# 3-32 letters, numbers, underscores, or hyphens. Connection verifies this owner.
PSN_ONLINE_ID=your-psn-online-id
# Shared PSN/Steam/Epic data parent. On Railway with /app/cache mounted, use /app/cache/gaming.
GAMING_DATA_DIR=cache/gaming
# Set one for PSN/Epic: a 64-character random hex key in hosting secrets, or a private local key file.
# GAMING_ENCRYPTION_KEY=
# GAMING_ENCRYPTION_KEY_FILE=.private/psn.key
# Allowed ranges: refresh 5-1440m, presence 30-3600s, details 15-1440m, stale 1-168h.
PSN_REFRESH_MINUTES=15
PSN_PRESENCE_SECONDS=60
PSN_DETAILS_MINUTES=60
PSN_MAX_STALE_HOURS=24

# Steam is opt-in. The API key remains server-side and is never sent to clients.
ENABLE_STEAM=false
STEAM_ID=your-17-digit-steamid64
# STEAM_WEB_API_KEY=
STEAM_LANGUAGE=english
# Uses GAMING_DATA_DIR above; Railway should keep /app/cache/gaming on its volume.
STEAM_REFRESH_MINUTES=15
STEAM_DETAILS_MINUTES=720
STEAM_MAX_STALE_HOURS=24

# Epic is opt-in. It reuses the private GAMING_ENCRYPTION_KEY configured for PSN.
ENABLE_EPIC=false
EPIC_EXPECTED_DISPLAY_NAME=your-epic-display-name
EPIC_REFRESH_MINUTES=15
EPIC_CATALOG_HOURS=24
EPIC_MAX_STALE_HOURS=24
